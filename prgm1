int leds[] = {2, 3, 4, 5, 6};  // LED pins
int numLeds = 5;

void setup() {
  for(int i = 0; i < numLeds; i++) {
    pinMode(leds[i], OUTPUT);
  }
}

void loop() {

  // Forward direction
  for(int i = 0; i < numLeds; i++) {
    digitalWrite(leds[i], HIGH);
    delay(1000);
    digitalWrite(leds[i], LOW);
    delay(100);
  }

  // Reverse direction (skip first & last to avoid repeat)
  for(int i = numLeds - 2; i > 0; i--) {
    digitalWrite(leds[i], HIGH);
    delay(1000);
    digitalWrite(leds[i], LOW);
    delay(100);
  }
}
